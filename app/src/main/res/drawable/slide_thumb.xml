<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:startColor="#4A90D9"
                android:endColor="#3A7BC8"
                android:angle="90"/>
            <corners android:radius="22dp"/>
            <size
                android:width="44dp"
                android:height="44dp"/>
        </shape>
    </item>
    <item
        android:drawable="@drawable/slide_arrow"
        android:gravity="center"/>
</layer-list>